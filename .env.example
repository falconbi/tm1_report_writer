# ── TM1 Connection ────────────────────────────────────────────────────────────
# Set TM1_ENABLED to "true" and fill in the values below to connect to a live
# IBM Planning Analytics (TM1) on-premises server (v11 or v12).
TM1_ENABLED=false
TM1_ADDRESS=
TM1_PORT=
TM1_USER=
TM1_CLIENT_ID=
TM1_CLIENT_SECRET=

# ── Application ───────────────────────────────────────────────────────────────
# Directory for the SQLite database and uploaded images.
# When running via Docker this is mounted as a volume (./data:/data).
DATA_DIR=/data
